\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Community-level selection is prevalent in microbial coalescence}{4}{subsection.2.1}\protected@file@percent }
\newlabel{sec:results:cls_prevalent}{{2.1}{4}{Community-level selection is prevalent in microbial coalescence}{subsection.2.1}{}}
\newlabel{eq:similarity}{{1}{4}{Community-level selection is prevalent in microbial coalescence}{equation.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fig.\nobreakspace  {}1. Experimental coalescence of synthetic microbial communities.} Community-level selection (CLS) is the dominant outcome when two parental communities are mixed, where one parent is dominantly selected over the other. \textbf  {a}, Schematic of community coalescence: parental communities A and B are mixed to produce coalesced community C. Outcomes are classified as CLS (C resembles one parent), Mixture (C resembles both parents equally), or Restructuring (C differs from both parents). \textbf  {b}, We use cosine similarity to quantify compositional resemblance between communities and define a two-dimensional similarity map for classifying outcomes. \textbf  {c}, Experimental workflow: we curated 54 bacterial isolates from soil, tree leaves, and flower stamen, then assembled 42 parental communities with varying initial richness (6, 12, or 24 species). Communities were stabilized through 7 rounds of serial growth-dilution (30$\times $ daily), mixed pairwise to generate 82 coalescence events, and restabilized for an additional 7 rounds. Community composition was measured by 16S rRNA amplicon sequencing. \textbf  {d}, Three representative time courses of relative species abundance. The left two panels show CLS outcomes where one parental community dominates; the right panel shows a Restructuring outcome. \textbf  {e}, CLS is the most frequent outcome in Base medium. Of 82 analyzable coalescence events, 54 (66\%) were classified as CLS, 26 (32\%) as Restructuring, and only 2 (2\%) as Mixture (chi-square test, $P <0.001$ compared to uniform distribution). Different symbols indicate initial richness (circles: 6; squares: 12; triangles: 24 species).\relax }}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig1}{{1}{7}{\textbf {Fig.~1. Experimental coalescence of synthetic microbial communities.} Community-level selection (CLS) is the dominant outcome when two parental communities are mixed, where one parent is dominantly selected over the other. \textbf {a}, Schematic of community coalescence: parental communities A and B are mixed to produce coalesced community C. Outcomes are classified as CLS (C resembles one parent), Mixture (C resembles both parents equally), or Restructuring (C differs from both parents). \textbf {b}, We use cosine similarity to quantify compositional resemblance between communities and define a two-dimensional similarity map for classifying outcomes. \textbf {c}, Experimental workflow: we curated 54 bacterial isolates from soil, tree leaves, and flower stamen, then assembled 42 parental communities with varying initial richness (6, 12, or 24 species). Communities were stabilized through 7 rounds of serial growth-dilution (30$\times $ daily), mixed pairwise to generate 82 coalescence events, and restabilized for an additional 7 rounds. Community composition was measured by 16S rRNA amplicon sequencing. \textbf {d}, Three representative time courses of relative species abundance. The left two panels show CLS outcomes where one parental community dominates; the right panel shows a Restructuring outcome. \textbf {e}, CLS is the most frequent outcome in Base medium. Of 82 analyzable coalescence events, 54 (66\%) were classified as CLS, 26 (32\%) as Restructuring, and only 2 (2\%) as Mixture (chi-square test, $P <0.001$ compared to uniform distribution). Different symbols indicate initial richness (circles: 6; squares: 12; triangles: 24 species).\relax }{figure.caption.1}{}}
\citation{Hu2022,Hu2025}
\citation{Gilpin1994,Lechon2021}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Theoretical model with random gLV interactions reproduces community-level selection}{8}{subsection.2.2}\protected@file@percent }
\newlabel{sec:results:glv_model}{{2.2}{8}{Theoretical model with random gLV interactions reproduces community-level selection}{subsection.2.2}{}}
\newlabel{eq:glv}{{2}{8}{Theoretical model with random gLV interactions reproduces community-level selection}{equation.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Fig.\nobreakspace  {}2. Generalized Lotka--Volterra model of community coalescence.} Random competitive interactions are sufficient to reproduce the high frequency of community-level selection observed in experiments. \textbf  {a}, Simulation workflow: species grow according to the generalized Lotka--Volterra (gLV) equations, where competitive interaction coefficients $\alpha _{ij}$ are drawn from a uniform distribution $\mathbb  {U}(0, 2\mu )$ with mean $\mu $ controlling average interaction strength. Two non-overlapping parental communities are assembled to steady state, then mixed and allowed to restabilize. The dashed line indicates the extinction threshold. \textbf  {b}, At interaction strength $\mu = 0.6$, the model reproduces the high frequency of CLS observed experimentally. The density map shows the distribution of 1,000 simulated coalescence outcomes in similarity space, with most outcomes clustering near the axes: CLS 61\%, Restructuring 26\%, Mixture 13\%. \textbf  {c}, Community assembly reduces mean pairwise interaction strength among surviving species compared to the initial pool (paired $t$-test, $P <0.001$, $n = 1{,}000$ communities). \textbf  {d}, Species from the same parental community show positively correlated selection outcomes, while cross-parent species pairs show negative correlation. This pattern appears in both simulations (left; $\mu = 0.6$, $n = 1{,}000$ coalescence events) and experiments (right; $n = 82$ coalescence events). Permutation test, $P <0.001$. Error bars, s.e.m.\relax }}{9}{figure.caption.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{9}{\textbf {Fig.~2. Generalized Lotka--Volterra model of community coalescence.} Random competitive interactions are sufficient to reproduce the high frequency of community-level selection observed in experiments. \textbf {a}, Simulation workflow: species grow according to the generalized Lotka--Volterra (gLV) equations, where competitive interaction coefficients $\alpha _{ij}$ are drawn from a uniform distribution $\mathbb {U}(0, 2\mu )$ with mean $\mu $ controlling average interaction strength. Two non-overlapping parental communities are assembled to steady state, then mixed and allowed to restabilize. The dashed line indicates the extinction threshold. \textbf {b}, At interaction strength $\mu = 0.6$, the model reproduces the high frequency of CLS observed experimentally. The density map shows the distribution of 1,000 simulated coalescence outcomes in similarity space, with most outcomes clustering near the axes: CLS 61\%, Restructuring 26\%, Mixture 13\%. \textbf {c}, Community assembly reduces mean pairwise interaction strength among surviving species compared to the initial pool (paired $t$-test, $P <0.001$, $n = 1{,}000$ communities). \textbf {d}, Species from the same parental community show positively correlated selection outcomes, while cross-parent species pairs show negative correlation. This pattern appears in both simulations (left; $\mu = 0.6$, $n = 1{,}000$ coalescence events) and experiments (right; $n = 82$ coalescence events). Permutation test, $P <0.001$. Error bars, s.e.m.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Interaction strength controls the occurrence of community-level selection}{9}{subsection.2.3}\protected@file@percent }
\newlabel{sec:results:interaction_strength}{{2.3}{9}{Interaction strength controls the occurrence of community-level selection}{subsection.2.3}{}}
\citation{Hu2022,Ratzke2020,Hu2025}
\citation{Ratzke2020}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Fig.\nobreakspace  {}3. Interaction strength controls the transition between coalescence outcome types in simulation.} In the gLV model, increasing interaction strength shifts coalescence outcomes from Mixture toward community-level selection. \textbf  {a}, Simulated coalescence outcome maps at three representative interaction strengths: $\mu = 0.3$, $0.6$, $0.8$; $n = 1{,}000$ simulations per condition. At weak interactions, outcomes cluster near the diagonal, indicating Mixture; as $\mu $ increases, outcomes shift toward the axes, indicating CLS. Histograms below show Parental Dominance Index (PDI) distributions, which shift from unimodal to bimodal with increasing interaction strength. \textbf  {b}, Coalescence outcome fractions across interaction strengths $\mu = 0$--$1.2$; $n = 1{,}000$ per $\mu $ value. Mixture dominates at low $\mu $, while CLS becomes increasingly prevalent as $\mu $ increases. Restructuring emerges at intermediate to high interaction strengths. Error bars, s.e.m.\relax }}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{11}{\textbf {Fig.~3. Interaction strength controls the transition between coalescence outcome types in simulation.} In the gLV model, increasing interaction strength shifts coalescence outcomes from Mixture toward community-level selection. \textbf {a}, Simulated coalescence outcome maps at three representative interaction strengths: $\mu = 0.3$, $0.6$, $0.8$; $n = 1{,}000$ simulations per condition. At weak interactions, outcomes cluster near the diagonal, indicating Mixture; as $\mu $ increases, outcomes shift toward the axes, indicating CLS. Histograms below show Parental Dominance Index (PDI) distributions, which shift from unimodal to bimodal with increasing interaction strength. \textbf {b}, Coalescence outcome fractions across interaction strengths $\mu = 0$--$1.2$; $n = 1{,}000$ per $\mu $ value. Mixture dominates at low $\mu $, while CLS becomes increasingly prevalent as $\mu $ increases. Restructuring emerges at intermediate to high interaction strengths. Error bars, s.e.m.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Nutrient-dependent interaction strength in experiments recapitulates model predictions}{11}{subsection.2.4}\protected@file@percent }
\newlabel{sec:results:nutrient_experiment}{{2.4}{11}{Nutrient-dependent interaction strength in experiments recapitulates model predictions}{subsection.2.4}{}}
\citation{Rillig2015,Castledine2020}
\citation{Hu2022,Ratzke2020}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Fig.\nobreakspace  {}4. Nutrient concentration modulates interaction strength and validates model predictions.} Experimental manipulation of nutrient concentration confirms that stronger interactions shift coalescence outcomes from Mixture toward community-level selection. \textbf  {a}, Schematic of nutrient manipulation: we varied glucose and urea concentrations to create three media conditions with increasing interaction strength. Nutr$-$ has no added glucose/urea and produces weak interactions, Base medium produces moderate interactions, and Nutr+ has high glucose/urea supplementation and produces strong interactions. \textbf  {b}, Pairwise invasion assays confirm that nutrient concentration modulates interaction strength. We measured the frequency of failed invasions among the 12 most abundant isolates at 95:5 initial frequency ratio, $n = 132$ assays per medium. Failed invasion frequency increases monotonically with nutrient concentration (Nutr$-$: $2 \pm 1\%$, Base: $33 \pm 4\%$, Nutr+: $48 \pm 4\%$; mean $\pm $ s.e.m.), confirming stronger competitive exclusion under higher nutrients. \textbf  {c}, Coalescence outcome distributions shift systematically with nutrient concentration. Scatter plots show outcomes in similarity space for each medium (Nutr$-$: $n = 90$, magenta; Base: $n = 82$, brown; Nutr+: $n = 90$, orange). Different symbols indicate initial richness. Histograms below show PDI distributions. Under weak interactions, outcomes cluster near the diagonal; under strong interactions, outcomes shift toward the axes. \textbf  {d}, The fraction of CLS increases with nutrient concentration (34\% in Nutr$-$, 60\% in Base, 72\% in Nutr+) while Mixture declines from 56\% to 8\% to 6\% (chi-square test for trend, $P <0.001$), consistent with model predictions. Error bars, s.e.m.\relax }}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:fig4}{{4}{13}{\textbf {Fig.~4. Nutrient concentration modulates interaction strength and validates model predictions.} Experimental manipulation of nutrient concentration confirms that stronger interactions shift coalescence outcomes from Mixture toward community-level selection. \textbf {a}, Schematic of nutrient manipulation: we varied glucose and urea concentrations to create three media conditions with increasing interaction strength. Nutr$-$ has no added glucose/urea and produces weak interactions, Base medium produces moderate interactions, and Nutr+ has high glucose/urea supplementation and produces strong interactions. \textbf {b}, Pairwise invasion assays confirm that nutrient concentration modulates interaction strength. We measured the frequency of failed invasions among the 12 most abundant isolates at 95:5 initial frequency ratio, $n = 132$ assays per medium. Failed invasion frequency increases monotonically with nutrient concentration (Nutr$-$: $2 \pm 1\%$, Base: $33 \pm 4\%$, Nutr+: $48 \pm 4\%$; mean $\pm $ s.e.m.), confirming stronger competitive exclusion under higher nutrients. \textbf {c}, Coalescence outcome distributions shift systematically with nutrient concentration. Scatter plots show outcomes in similarity space for each medium (Nutr$-$: $n = 90$, magenta; Base: $n = 82$, brown; Nutr+: $n = 90$, orange). Different symbols indicate initial richness. Histograms below show PDI distributions. Under weak interactions, outcomes cluster near the diagonal; under strong interactions, outcomes shift toward the axes. \textbf {d}, The fraction of CLS increases with nutrient concentration (34\% in Nutr$-$, 60\% in Base, 72\% in Nutr+) while Mixture declines from 56\% to 8\% to 6\% (chi-square test for trend, $P <0.001$), consistent with model predictions. Error bars, s.e.m.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Predictability of community-level selection separates into two regimes}{13}{subsection.2.5}\protected@file@percent }
\newlabel{sec:results:predictability}{{2.5}{13}{Predictability of community-level selection separates into two regimes}{subsection.2.5}{}}
\citation{Ratzke2018,Ratzke2020}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Fig.\nobreakspace  {}5. Predictability of community-level selection direction reveals two mechanistic regimes.} The direction of CLS (which parental community dominates) becomes predictable from dominant species competition only under strong interactions. \textbf  {a}, Schematic illustrating the core question: can pairwise competition between dominant species predict which community wins during coalescence? \textbf  {b}, The relative abundance of dominant species increases with nutrient concentration (Nutr$-$: 44\%; Base: 51\%; Nutr+: 67\%; $n = 90$, 82, 90 communities respectively), suggesting that dominant species have larger relative influence under stronger interactions. Error bars, s.e.m. \textbf  {c}, Predictability of CLS direction from dominant-species pairwise competition. Scatter plots show dominant species competitive success versus Parental Dominance Index of coalescence outcomes; gray shaded regions indicate CLS outcomes. Predictive power increases with interaction strength: $R^2 = 0.00$ in Nutr$-$ where Mixture dominates, $R^2 = 0.11$ ($P = 0.03$) in Base where multi-species dynamics shape outcomes, and $R^2 = 0.49$ ($P <0.001$) in Nutr+ where dominant species determine outcomes. Linear regression with 95\% confidence intervals shown.\relax }}{15}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fig5}{{5}{15}{\textbf {Fig.~5. Predictability of community-level selection direction reveals two mechanistic regimes.} The direction of CLS (which parental community dominates) becomes predictable from dominant species competition only under strong interactions. \textbf {a}, Schematic illustrating the core question: can pairwise competition between dominant species predict which community wins during coalescence? \textbf {b}, The relative abundance of dominant species increases with nutrient concentration (Nutr$-$: 44\%; Base: 51\%; Nutr+: 67\%; $n = 90$, 82, 90 communities respectively), suggesting that dominant species have larger relative influence under stronger interactions. Error bars, s.e.m. \textbf {c}, Predictability of CLS direction from dominant-species pairwise competition. Scatter plots show dominant species competitive success versus Parental Dominance Index of coalescence outcomes; gray shaded regions indicate CLS outcomes. Predictive power increases with interaction strength: $R^2 = 0.00$ in Nutr$-$ where Mixture dominates, $R^2 = 0.11$ ($P = 0.03$) in Base where multi-species dynamics shape outcomes, and $R^2 = 0.49$ ($P <0.001$) in Nutr+ where dominant species determine outcomes. Linear regression with 95\% confidence intervals shown.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}Community-level selection generalizes to natural sample-derived communities}{16}{subsection.2.6}\protected@file@percent }
\newlabel{sec:results:natural_communities}{{2.6}{16}{Community-level selection generalizes to natural sample-derived communities}{subsection.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Fig.\nobreakspace  {}6. Community-level selection generalizes to natural sample-derived communities.} Natural environmental communities show qualitatively similar coalescence patterns to synthetic communities, with CLS frequency increasing under higher nutrient concentration. \textbf  {a}, Experimental workflow follows Fig.\nobreakspace  {}1c, but uses natural sample-derived communities from six environmental samples including soil, compost, and decomposing organic matter. \textbf  {b}, Coalescence outcome distributions in similarity space for natural communities across three media conditions ($n = 16$ coalescence events per condition). Similar to synthetic communities, outcomes cluster near the diagonal under weak interactions and shift toward the axes under strong interactions. Histograms below show PDI distributions. \textbf  {c}, The fraction of CLS outcomes increases with nutrient concentration in natural communities (57\% in Nutr$-$, 83\% in Base, 90\% in Nutr+), consistent with synthetic communities. Error bars, s.e.m.\relax }}{17}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fig6}{{6}{17}{\textbf {Fig.~6. Community-level selection generalizes to natural sample-derived communities.} Natural environmental communities show qualitatively similar coalescence patterns to synthetic communities, with CLS frequency increasing under higher nutrient concentration. \textbf {a}, Experimental workflow follows Fig.~1c, but uses natural sample-derived communities from six environmental samples including soil, compost, and decomposing organic matter. \textbf {b}, Coalescence outcome distributions in similarity space for natural communities across three media conditions ($n = 16$ coalescence events per condition). Similar to synthetic communities, outcomes cluster near the diagonal under weak interactions and shift toward the axes under strong interactions. Histograms below show PDI distributions. \textbf {c}, The fraction of CLS outcomes increases with nutrient concentration in natural communities (57\% in Nutr$-$, 83\% in Base, 90\% in Nutr+), consistent with synthetic communities. Error bars, s.e.m.\relax }{figure.caption.6}{}}
