\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}8.} Monoculture pH modification by bacterial isolates. Distribution of monoculture pH after 15\nobreakspace  {}h growth for all ASVs, showing the range of pH modification abilities relative to the initial pH of 6.5. Strong acidifiers (monoculture pH $<$ 5) include ASV 12 (\textit  {Serratia}), ASV 3 (\textit  {Enterobacter}), and ASV 8 (\textit  {Citrobacter}). Species that maintain or slightly increase pH above initial (monoculture pH $>$ 6.5) include ASV 11 (\textit  {Stenotrophomonas}) and ASV 9 (\textit  {Pseudomonas}). Bottom legend shows taxa identities for the labeled ASVs.\relax }}{24}{figure.caption.34}\protected@file@percent }
\newlabel{fig:suppl_s8}{{16}{24}{\textbf {Supplementary Fig.~8.} Monoculture pH modification by bacterial isolates. Distribution of monoculture pH after 15~h growth for all ASVs, showing the range of pH modification abilities relative to the initial pH of 6.5. Strong acidifiers (monoculture pH $<$ 5) include ASV 12 (\textit {Serratia}), ASV 3 (\textit {Enterobacter}), and ASV 8 (\textit {Citrobacter}). Species that maintain or slightly increase pH above initial (monoculture pH $>$ 6.5) include ASV 11 (\textit {Stenotrophomonas}) and ASV 9 (\textit {Pseudomonas}). Bottom legend shows taxa identities for the labeled ASVs.\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}9.} Dominant species class (acidifier vs.\ alkalizer) determines parental community pH. Scatter plots showing the relationship between dominant ASV relative abundance in parental communities and the resulting community pH at stabilization. Top row: alkalizers including ASV 9 (\textit  {Pseudomonas}) and ASV 11 (\textit  {Stenotrophomonas}), whose dominance is associated with higher community pH. Bottom row: acidifiers including ASV 3 (\textit  {Enterobacter}), ASV 8 (\textit  {Citrobacter}), and ASV 12 (\textit  {Serratia}), whose dominance is associated with lower community pH. For each ASV, left panel shows Base medium and right panel shows Nutr$+$ medium. Regression lines and correlation coefficients shown; asterisks indicate $p < 0.05$.\relax }}{24}{figure.caption.35}\protected@file@percent }
\newlabel{fig:suppl_s9}{{17}{24}{\textbf {Supplementary Fig.~9.} Dominant species class (acidifier vs.\ alkalizer) determines parental community pH. Scatter plots showing the relationship between dominant ASV relative abundance in parental communities and the resulting community pH at stabilization. Top row: alkalizers including ASV 9 (\textit {Pseudomonas}) and ASV 11 (\textit {Stenotrophomonas}), whose dominance is associated with higher community pH. Bottom row: acidifiers including ASV 3 (\textit {Enterobacter}), ASV 8 (\textit {Citrobacter}), and ASV 12 (\textit {Serratia}), whose dominance is associated with lower community pH. For each ASV, left panel shows Base medium and right panel shows Nutr$+$ medium. Regression lines and correlation coefficients shown; asterisks indicate $p < 0.05$.\relax }{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}10.} Rank-abundance curves comparing parental and coalesced communities in Base medium. \textbf  {(a)} Parental communities before coalescence. \textbf  {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Gini coefficients quantify abundance inequality (0 = perfectly even, 1 = one species dominates). Parental: Gini = 0.62 $\pm $ 0.19 (n=59); Coalesced: Gini = 0.64 $\pm $ 0.15 (n=94). Both parental and coalesced communities exhibit substantial abundance skewness with similar Gini values.\relax }}{25}{figure.caption.36}\protected@file@percent }
\newlabel{fig:suppl_s10}{{18}{25}{\textbf {Supplementary Fig.~10.} Rank-abundance curves comparing parental and coalesced communities in Base medium. \textbf {(a)} Parental communities before coalescence. \textbf {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Gini coefficients quantify abundance inequality (0 = perfectly even, 1 = one species dominates). Parental: Gini = 0.62 $\pm $ 0.19 (n=59); Coalesced: Gini = 0.64 $\pm $ 0.15 (n=94). Both parental and coalesced communities exhibit substantial abundance skewness with similar Gini values.\relax }{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}11.} Rank-abundance curves comparing parental and coalesced communities in Nutr$-$ medium. \textbf  {(a)} Parental communities before coalescence. \textbf  {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Parental: Gini = 0.63 $\pm $ 0.09 (n=60); Coalesced: Gini = 0.61 $\pm $ 0.12 (n=92).\relax }}{25}{figure.caption.37}\protected@file@percent }
\newlabel{fig:suppl_s11}{{19}{25}{\textbf {Supplementary Fig.~11.} Rank-abundance curves comparing parental and coalesced communities in Nutr$-$ medium. \textbf {(a)} Parental communities before coalescence. \textbf {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Parental: Gini = 0.63 $\pm $ 0.09 (n=60); Coalesced: Gini = 0.61 $\pm $ 0.12 (n=92).\relax }{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}12.} Rank-abundance curves comparing parental and coalesced communities in Nutr$+$ medium. \textbf  {(a)} Parental communities before coalescence. \textbf  {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Parental: Gini = 0.64 $\pm $ 0.17 (n=60); Coalesced: Gini = 0.66 $\pm $ 0.14 (n=94).\relax }}{26}{figure.caption.38}\protected@file@percent }
\newlabel{fig:suppl_s12}{{20}{26}{\textbf {Supplementary Fig.~12.} Rank-abundance curves comparing parental and coalesced communities in Nutr$+$ medium. \textbf {(a)} Parental communities before coalescence. \textbf {(b)} Coalesced communities after coalescence. Each line represents one community's rank-abundance curve. Parental: Gini = 0.64 $\pm $ 0.17 (n=60); Coalesced: Gini = 0.66 $\pm $ 0.14 (n=94).\relax }{figure.caption.38}{}}
