\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}1.} Phylogenetic tree of bacterial isolates. Maximum-likelihood phylogenetic tree based on full-length 16S rRNA gene sequences of the 54 bacterial isolates used in this study. Tree was constructed using EMBL-EBI tools\citep  {Madeira2022}. The isolates span three phyla (Proteobacteria, Firmicutes, Bacteroidota) and 29 families, representing broad phylogenetic diversity.\relax }}{18}{figure.caption.27}\protected@file@percent }
\newlabel{fig:suppl_s1}{{9}{18}{\textbf {Supplementary Fig.~1.} Phylogenetic tree of bacterial isolates. Maximum-likelihood phylogenetic tree based on full-length 16S rRNA gene sequences of the 54 bacterial isolates used in this study. Tree was constructed using EMBL-EBI tools\citep {Madeira2022}. The isolates span three phyla (Proteobacteria, Firmicutes, Bacteroidota) and 29 families, representing broad phylogenetic diversity.\relax }{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}2.} Phase diagrams with growth-rate heterogeneity. Coalescence outcomes when species have heterogeneous intrinsic growth rates sampled from normal distributions with mean 1 and standard deviations of \textbf  {(a)} 0.1 and \textbf  {(b)} 0.2. The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing interaction strength is robust to growth-rate variation.\relax }}{19}{figure.caption.28}\protected@file@percent }
\newlabel{fig:suppl_s2}{{10}{19}{\textbf {Supplementary Fig.~2.} Phase diagrams with growth-rate heterogeneity. Coalescence outcomes when species have heterogeneous intrinsic growth rates sampled from normal distributions with mean 1 and standard deviations of \textbf {(a)} 0.1 and \textbf {(b)} 0.2. The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing interaction strength is robust to growth-rate variation.\relax }{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}3.} Phase diagrams with carrying-capacity variation. Coalescence outcomes when species have heterogeneous carrying capacities sampled from normal distributions with mean 1 and standard deviations of \textbf  {(a)} 0.1 and \textbf  {(b)} 0.2. The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing interaction strength is robust to carrying-capacity variation.\relax }}{19}{figure.caption.29}\protected@file@percent }
\newlabel{fig:suppl_s3}{{11}{19}{\textbf {Supplementary Fig.~3.} Phase diagrams with carrying-capacity variation. Coalescence outcomes when species have heterogeneous carrying capacities sampled from normal distributions with mean 1 and standard deviations of \textbf {(a)} 0.1 and \textbf {(b)} 0.2. The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing interaction strength is robust to carrying-capacity variation.\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}4.} Phase diagrams for alternative interaction coefficient distributions. Both distributions have the same mean and variance but different shapes. \textbf  {(a)} Gaussian distribution (truncated at 0 to ensure non-negative coefficients). \textbf  {(b)} Gamma distribution (inherently non-negative). The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing mean interaction strength $\mu $ is robust to the choice of distribution, confirming that the observed patterns depend primarily on interaction strength rather than distributional details.\relax }}{20}{figure.caption.30}\protected@file@percent }
\newlabel{fig:suppl_s4}{{12}{20}{\textbf {Supplementary Fig.~4.} Phase diagrams for alternative interaction coefficient distributions. Both distributions have the same mean and variance but different shapes. \textbf {(a)} Gaussian distribution (truncated at 0 to ensure non-negative coefficients). \textbf {(b)} Gamma distribution (inherently non-negative). The qualitative transition from Mixture-dominated to Dominance/Restructuring outcomes with increasing mean interaction strength $\mu $ is robust to the choice of distribution, confirming that the observed patterns depend primarily on interaction strength rather than distributional details.\relax }{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}5.} Pairwise invasion outcomes in Nutr$-$ medium. Matrix showing competitive outcomes among the 12 most abundant isolates. Each cell indicates whether the invader (initially 5\%) successfully established or was excluded after seven growth-dilution cycles. Low failed invasion frequency indicates weak competitive exclusion.\relax }}{21}{figure.caption.31}\protected@file@percent }
\newlabel{fig:suppl_s5}{{13}{21}{\textbf {Supplementary Fig.~5.} Pairwise invasion outcomes in Nutr$-$ medium. Matrix showing competitive outcomes among the 12 most abundant isolates. Each cell indicates whether the invader (initially 5\%) successfully established or was excluded after seven growth-dilution cycles. Low failed invasion frequency indicates weak competitive exclusion.\relax }{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}6.} Pairwise invasion outcomes in Base medium. Matrix showing competitive outcomes among the 12 most abundant isolates. Each cell indicates whether the invader (initially 5\%) successfully established or was excluded after seven growth-dilution cycles. Intermediate failed invasion frequency indicates moderate competitive exclusion.\relax }}{22}{figure.caption.32}\protected@file@percent }
\newlabel{fig:suppl_s6}{{14}{22}{\textbf {Supplementary Fig.~6.} Pairwise invasion outcomes in Base medium. Matrix showing competitive outcomes among the 12 most abundant isolates. Each cell indicates whether the invader (initially 5\%) successfully established or was excluded after seven growth-dilution cycles. Intermediate failed invasion frequency indicates moderate competitive exclusion.\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Supplementary Fig.\nobreakspace  {}7.} Pairwise invasion outcomes in Nutr$+$ medium. Matrix showing competitive outcomes among the 12 most abundant isolates. Each cell indicates whether the invader (initially 5\%) successfully established or was excluded after seven growth-dilution cycles. High failed invasion frequency indicates strong competitive exclusion.\relax }}{23}{figure.caption.33}\protected@file@percent }
