\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Community-level selection is prevalent in microbial coalescence}{4}{subsection.2.1}\protected@file@percent }
\newlabel{sec:results:cls_prevalent}{{2.1}{4}{Community-level selection is prevalent in microbial coalescence}{subsection.2.1}{}}
\newlabel{eq:similarity}{{1}{4}{Community-level selection is prevalent in microbial coalescence}{equation.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Community-level selection is the dominant outcome in experimental microbial coalescence.} \textbf  {(A)} Coalescence schematic: communities A and B mix to produce C, classified as CLS, Mixture, or Restructuring. \textbf  {(B)} Cosine similarity quantifies compositional resemblance. \textbf  {(C)} Experimental workflow: 54 isolates assembled into 42 parental communities, pairwise coalesced, tracked by 16S sequencing. \textbf  {(D)} Representative time-series: two CLS outcomes and one Restructuring outcome. \textbf  {(E)} CLS is the dominant outcome (65.9\%, 54/82; $n = 82$ coalescence events), followed by Restructuring (31.7\%) and Mixture (2.4\%).\relax }}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig1}{{1}{6}{\textbf {Community-level selection is the dominant outcome in experimental microbial coalescence.} \textbf {(A)} Coalescence schematic: communities A and B mix to produce C, classified as CLS, Mixture, or Restructuring. \textbf {(B)} Cosine similarity quantifies compositional resemblance. \textbf {(C)} Experimental workflow: 54 isolates assembled into 42 parental communities, pairwise coalesced, tracked by 16S sequencing. \textbf {(D)} Representative time-series: two CLS outcomes and one Restructuring outcome. \textbf {(E)} CLS is the dominant outcome (65.9\%, 54/82; $n = 82$ coalescence events), followed by Restructuring (31.7\%) and Mixture (2.4\%).\relax }{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Theoretical model with random gLV interactions reproduces community-level selection}{6}{subsection.2.2}\protected@file@percent }
\newlabel{sec:results:glv_model}{{2.2}{6}{Theoretical model with random gLV interactions reproduces community-level selection}{subsection.2.2}{}}
\citation{Hu2022,Hu2025}
\citation{Gilpin1994,Lechon2021}
\newlabel{eq:glv}{{2}{7}{Theoretical model with random gLV interactions reproduces community-level selection}{equation.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Random competitive interactions are sufficient to reproduce community-level selection.} \textbf  {(A)} gLV simulation workflow: interaction coefficients drawn from Uniform($0, 2\mu $); communities ($N = 48$ pool, $S = 12$) assembled to steady state, mixed, re-stabilized. \textbf  {(B)} At $\mu = 0.6$, simulations reproduce high CLS ($n = 200$). \textbf  {(C)} Assembly reduces mean interaction strength ($n = 200$; paired $t$-test, $P < 0.001$). \textbf  {(D)} Same-parent species show positive selection correlation; cross-parent pairs show negative correlation (simulation: $\mu = 0.6$, $n = 200$; experiment: $n = 82$; permutation test, $P < 0.001$).\relax }}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{8}{\textbf {Random competitive interactions are sufficient to reproduce community-level selection.} \textbf {(A)} gLV simulation workflow: interaction coefficients drawn from Uniform($0, 2\mu $); communities ($N = 48$ pool, $S = 12$) assembled to steady state, mixed, re-stabilized. \textbf {(B)} At $\mu = 0.6$, simulations reproduce high CLS ($n = 200$). \textbf {(C)} Assembly reduces mean interaction strength ($n = 200$; paired $t$-test, $P < 0.001$). \textbf {(D)} Same-parent species show positive selection correlation; cross-parent pairs show negative correlation (simulation: $\mu = 0.6$, $n = 200$; experiment: $n = 82$; permutation test, $P < 0.001$).\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Interaction strength controls the occurrence of community-level selection}{8}{subsection.2.3}\protected@file@percent }
\newlabel{sec:results:interaction_strength}{{2.3}{8}{Interaction strength controls the occurrence of community-level selection}{subsection.2.3}{}}
\newlabel{eq:pdi}{{3}{9}{Interaction strength controls the occurrence of community-level selection}{equation.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Stronger interactions shift coalescence outcomes from Mixture toward community-level selection.} \textbf  {(A)} Coalescence-outcome maps at three interaction strengths ($\mu = 0.3, 0.6, 0.8$; $n = 1{,}000$ coalescence events per condition). Polar heatmaps show outcome density in similarity space; histograms show Parental Dominance Index (PDI) distributions. Weak interactions ($\mu = 0.3$) produce Mixture-dominated outcomes; stronger interactions shift outcomes toward CLS. \textbf  {(B)} Outcome fractions across interaction strengths ($\mu = 0$--$1.2$; $n = 1{,}000$ per $\mu $ value). Increasing $\mu $ shifts outcomes from Mixture toward CLS.\relax }}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{9}{\textbf {Stronger interactions shift coalescence outcomes from Mixture toward community-level selection.} \textbf {(A)} Coalescence-outcome maps at three interaction strengths ($\mu = 0.3, 0.6, 0.8$; $n = 1{,}000$ coalescence events per condition). Polar heatmaps show outcome density in similarity space; histograms show Parental Dominance Index (PDI) distributions. Weak interactions ($\mu = 0.3$) produce Mixture-dominated outcomes; stronger interactions shift outcomes toward CLS. \textbf {(B)} Outcome fractions across interaction strengths ($\mu = 0$--$1.2$; $n = 1{,}000$ per $\mu $ value). Increasing $\mu $ shifts outcomes from Mixture toward CLS.\relax }{figure.caption.3}{}}
\citation{Hu2022,Ratzke2020,Hu2025}
\citation{Ratzke2020}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Nutrient-dependent interaction strength in experiments recapitulates model predictions}{10}{subsection.2.4}\protected@file@percent }
\newlabel{sec:results:nutrient_experiment}{{2.4}{10}{Nutrient-dependent interaction strength in experiments recapitulates model predictions}{subsection.2.4}{}}
\citation{Rillig2015,Castledine2020}
\citation{Hu2022,Ratzke2020}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Nutrient modulation validates the model-predicted dependence of coalescence outcomes on interaction strength.} \textbf  {(A)} Nutrient supply modulates interactions: Nutr$-$ (no glucose/urea), Base, Nutr+ (high supplementation). \textbf  {(B)} Failed invasion frequency increases with nutrients ($n = 132$ assays per medium), confirming stronger competition. \textbf  {(C)} Coalescence maps and PDI histograms per medium (Nutr$-$: $n = 90$; Base: $n = 82$; Nutr+: $n = 90$). Shapes indicate initial richness. \textbf  {(D)} CLS increases with nutrients (34\% $\rightarrow $ 60\% $\rightarrow $ 72\%); Mixture declines (56\% $\rightarrow $ 8\% $\rightarrow $ 6\%), confirming model predictions.\relax }}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:fig4}{{4}{11}{\textbf {Nutrient modulation validates the model-predicted dependence of coalescence outcomes on interaction strength.} \textbf {(A)} Nutrient supply modulates interactions: Nutr$-$ (no glucose/urea), Base, Nutr+ (high supplementation). \textbf {(B)} Failed invasion frequency increases with nutrients ($n = 132$ assays per medium), confirming stronger competition. \textbf {(C)} Coalescence maps and PDI histograms per medium (Nutr$-$: $n = 90$; Base: $n = 82$; Nutr+: $n = 90$). Shapes indicate initial richness. \textbf {(D)} CLS increases with nutrients (34\% $\rightarrow $ 60\% $\rightarrow $ 72\%); Mixture declines (56\% $\rightarrow $ 8\% $\rightarrow $ 6\%), confirming model predictions.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Predictability of community-level selection separates into two regimes}{11}{subsection.2.5}\protected@file@percent }
\newlabel{sec:results:predictability}{{2.5}{11}{Predictability of community-level selection separates into two regimes}{subsection.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Two mechanistic regimes underlie community-level selection: emergent versus species-driven dynamics.} \textbf  {(A)} CLS may arise from emergent dynamics (multi-species) or species-driven dynamics (dominant species). \textbf  {(B)} Dominant species abundance increases with nutrients (Nutr$-$: $n = 90$; Base: $n = 82$; Nutr+: $n = 90$). Error bars: s.e.m. \textbf  {(C)} Predictability of CLS direction from dominant-species pairwise competition. Invasion success (x-axis) vs PDI (y-axis). Predictive power increases: Nutr$-$ $R^2 = 0.00$; Base $R^2 = 0.11$ (emergent regime); Nutr+ $R^2 = 0.49$ (species-driven regime). Linear regression; shaded regions: 95\% CI.\relax }}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fig5}{{5}{12}{\textbf {Two mechanistic regimes underlie community-level selection: emergent versus species-driven dynamics.} \textbf {(A)} CLS may arise from emergent dynamics (multi-species) or species-driven dynamics (dominant species). \textbf {(B)} Dominant species abundance increases with nutrients (Nutr$-$: $n = 90$; Base: $n = 82$; Nutr+: $n = 90$). Error bars: s.e.m. \textbf {(C)} Predictability of CLS direction from dominant-species pairwise competition. Invasion success (x-axis) vs PDI (y-axis). Predictive power increases: Nutr$-$ $R^2 = 0.00$; Base $R^2 = 0.11$ (emergent regime); Nutr+ $R^2 = 0.49$ (species-driven regime). Linear regression; shaded regions: 95\% CI.\relax }{figure.caption.5}{}}
