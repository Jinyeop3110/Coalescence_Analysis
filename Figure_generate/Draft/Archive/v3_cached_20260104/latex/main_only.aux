\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Community-level selection is prevalent in microbial coalescence}{5}{subsection.2.1}\protected@file@percent }
\newlabel{sec:results:cls_prevalent}{{2.1}{5}{Community-level selection is prevalent in microbial coalescence}{subsection.2.1}{}}
\newlabel{eq:similarity}{{1}{5}{Community-level selection is prevalent in microbial coalescence}{equation.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Frequent community-level selection in experimental microbial community coalescence.} \textbf  {(A)} Schematic of community coalescence: two independently assembled parental communities, A and B, are mixed to form a coalescence outcome C. Coalescence outcomes are classified by the similarity of C to the parents into CLS (community-level selection for one parental community), Mixture (coexistence of both) or Restructuring (a novel community distinct from both parents). \textbf  {(B)} Community similarity is quantified using the cosine similarity between relative-abundance vectors of two communities, providing a measure of compositional resemblance. \textbf  {(C)} Experimental workflow: diverse bacterial isolates are obtained, assembled into distinct parental communities under standardized conditions, and then pairwise coalesced, with community composition tracked by 16S sequencing over time. \textbf  {(D)} Example time-series of relative abundances illustrating two CLS outcomes, in which one parental community is selected and largely maintains its composition across serial dilutions after coalescence, and a Restructuring outcome, in which a completely new community structure emerges after coalescence. \textbf  {(E)} Summary of 82 analyzable coalescence experiments showing that CLS is the most frequent outcome, occurring in 65.9\% of cases (54/82), with Mixture and Restructuring comprising the remainder.\relax }}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig1}{{1}{7}{\textbf {Frequent community-level selection in experimental microbial community coalescence.} \textbf {(A)} Schematic of community coalescence: two independently assembled parental communities, A and B, are mixed to form a coalescence outcome C. Coalescence outcomes are classified by the similarity of C to the parents into CLS (community-level selection for one parental community), Mixture (coexistence of both) or Restructuring (a novel community distinct from both parents). \textbf {(B)} Community similarity is quantified using the cosine similarity between relative-abundance vectors of two communities, providing a measure of compositional resemblance. \textbf {(C)} Experimental workflow: diverse bacterial isolates are obtained, assembled into distinct parental communities under standardized conditions, and then pairwise coalesced, with community composition tracked by 16S sequencing over time. \textbf {(D)} Example time-series of relative abundances illustrating two CLS outcomes, in which one parental community is selected and largely maintains its composition across serial dilutions after coalescence, and a Restructuring outcome, in which a completely new community structure emerges after coalescence. \textbf {(E)} Summary of 82 analyzable coalescence experiments showing that CLS is the most frequent outcome, occurring in 65.9\% of cases (54/82), with Mixture and Restructuring comprising the remainder.\relax }{figure.caption.1}{}}
\citation{Hu2022,Hu2025}
\citation{Gilpin1994,Lechon2021}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Theoretical model with Random gLV interactions reproduce community-level selection}{8}{subsection.2.2}\protected@file@percent }
\newlabel{sec:results:glv_model}{{2.2}{8}{Theoretical model with Random gLV interactions reproduce community-level selection}{subsection.2.2}{}}
\newlabel{eq:glv}{{2}{8}{Theoretical model with Random gLV interactions reproduce community-level selection}{equation.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Theoretical model for community-level selection.} \textbf  {(A)} Simulation workflow using a generalized Lotka--Volterra (gLV) model with a random pairwise interaction matrix. Interaction coefficients are drawn i.i.d.\ from a uniform distribution with mean interaction strength $\mu $. Parental communities A and B are first assembled to steady state (gray bands). At steady state, they are mixed 1:1 and allowed to re-stabilize to obtain coalescence outcome C. Example abundance trajectories are shown; the dashed line indicates the extinction threshold. \textbf  {(B)} Coalescence outcomes at $\mu = 0.6$ reproduce the observed high frequencies of CLS. The heatmap shows the distribution of outcomes in similarity space with density shading, and the pie chart shows the fractions of CLS, Mixture, and Restructuring outcomes over 500 runs with random initializations. \textbf  {(C)} Mean pairwise interaction strength before versus after assembly at $\mu = 0.6$. Surviving communities have weaker effective interactions on average (*** indicate significant difference; p-value $< 0.001$). \textbf  {(D)} Pairwise selection correlation for species from the same versus cross parental communities, in both simulation ($\mu = 0.6$) and experiment. For each species pair, we computed the Pearson correlation between their retention probabilities (fraction of coalescence events in which each species survived) across all coalescence events. Species pairs from the same parental community show strong positive correlation, whereas cross-parent pairs show near-zero or negative correlation (*** indicates a significant difference; $p < 0.001$).\relax }}{9}{figure.caption.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{9}{\textbf {Theoretical model for community-level selection.} \textbf {(A)} Simulation workflow using a generalized Lotka--Volterra (gLV) model with a random pairwise interaction matrix. Interaction coefficients are drawn i.i.d.\ from a uniform distribution with mean interaction strength $\mu $. Parental communities A and B are first assembled to steady state (gray bands). At steady state, they are mixed 1:1 and allowed to re-stabilize to obtain coalescence outcome C. Example abundance trajectories are shown; the dashed line indicates the extinction threshold. \textbf {(B)} Coalescence outcomes at $\mu = 0.6$ reproduce the observed high frequencies of CLS. The heatmap shows the distribution of outcomes in similarity space with density shading, and the pie chart shows the fractions of CLS, Mixture, and Restructuring outcomes over 500 runs with random initializations. \textbf {(C)} Mean pairwise interaction strength before versus after assembly at $\mu = 0.6$. Surviving communities have weaker effective interactions on average (*** indicate significant difference; p-value $< 0.001$). \textbf {(D)} Pairwise selection correlation for species from the same versus cross parental communities, in both simulation ($\mu = 0.6$) and experiment. For each species pair, we computed the Pearson correlation between their retention probabilities (fraction of coalescence events in which each species survived) across all coalescence events. Species pairs from the same parental community show strong positive correlation, whereas cross-parent pairs show near-zero or negative correlation (*** indicates a significant difference; $p < 0.001$).\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Interaction strength controls the occurrence of community-level selection}{10}{subsection.2.3}\protected@file@percent }
\newlabel{sec:results:interaction_strength}{{2.3}{10}{Interaction strength controls the occurrence of community-level selection}{subsection.2.3}{}}
\newlabel{eq:pss}{{3}{10}{Interaction strength controls the occurrence of community-level selection}{equation.2.3}{}}
\citation{Hu2022,Ratzke2020b,Hu2025}
\citation{Ratzke2020b}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Decreasing interaction strength causes community-level selection to disappear and favors mixtures.} \textbf  {(A)} Coalescence-outcome maps for three mean interaction strengths $\mu = 0.3, 0.6, 0.8$. Each polar heatmap shows the density of outcomes in the similarity space between the coalesced community C and parental communities A and B; regions correspond roughly to Mixture (M), community-level selection (CLS), and Restructuring (R). Histograms below each map show the distribution of Parental Selection Score (PSS). At weaker interactions ($\mu = 0.3$), CLS largely disappears and outcomes are dominated by Mixture, whereas stronger interactions increase the frequency of CLS. \textbf  {(B)} Fractions of CLS, Mixture, and Restructuring outcomes as a function of interaction strength $\mu $ (0.0--1.2). Stronger effective interspecies interactions (e.g., under nutrient enrichment) shift coalescence outcomes from Mixture toward community-level exclusion.\relax }}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{11}{\textbf {Decreasing interaction strength causes community-level selection to disappear and favors mixtures.} \textbf {(A)} Coalescence-outcome maps for three mean interaction strengths $\mu = 0.3, 0.6, 0.8$. Each polar heatmap shows the density of outcomes in the similarity space between the coalesced community C and parental communities A and B; regions correspond roughly to Mixture (M), community-level selection (CLS), and Restructuring (R). Histograms below each map show the distribution of Parental Selection Score (PSS). At weaker interactions ($\mu = 0.3$), CLS largely disappears and outcomes are dominated by Mixture, whereas stronger interactions increase the frequency of CLS. \textbf {(B)} Fractions of CLS, Mixture, and Restructuring outcomes as a function of interaction strength $\mu $ (0.0--1.2). Stronger effective interspecies interactions (e.g., under nutrient enrichment) shift coalescence outcomes from Mixture toward community-level exclusion.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Nutrient-dependent interaction strength in experiments recapitulates model predictions}{11}{subsection.2.4}\protected@file@percent }
\newlabel{sec:results:nutrient_experiment}{{2.4}{11}{Nutrient-dependent interaction strength in experiments recapitulates model predictions}{subsection.2.4}{}}
\citation{Rillig2015,Castledine2020}
\citation{Hu2022,Ratzke2020b}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Nutrient-dependent interaction strength in experiments recapitulates the model-predicted dependence of community-level selection on interaction strength.} \textbf  {(A)} Increasing nutrient supply acts as a controlling knob that strengthens competitive interactions. Communities were stabilized in three media: nutrient-poor (Nutr$-$, no added glucose/urea), baseline (Base), and nutrient-enriched (Nutr+, added glucose and urea). \textbf  {(B)} The top 12 abundant isolates (by ASV counts) were tested in reciprocal ``mutual invasion'' assays across the three media. Increasing nutrient concentrations lead to a higher frequency of failed species invasions in the pairwise invasion test, indicating nutrient enrichment strengthens competitive interactions. \textbf  {(C)} Experimental coalescence maps in similarity space and corresponding PSS histograms for each medium. Marker shapes denote parent pool size (richness class): circles = 6 species, squares = 12 species, triangles = 24 species. \textbf  {(D)} The fraction of CLS increases with interaction strength. In nutrient-poor conditions (Nutr$-$), Mixture is the dominant outcome (56\%), with CLS reduced to 34\%. As nutrients increase, CLS progressively dominates, reaching 72\% in Nutr+, consistent with the model prediction.\relax }}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:fig4}{{4}{12}{\textbf {Nutrient-dependent interaction strength in experiments recapitulates the model-predicted dependence of community-level selection on interaction strength.} \textbf {(A)} Increasing nutrient supply acts as a controlling knob that strengthens competitive interactions. Communities were stabilized in three media: nutrient-poor (Nutr$-$, no added glucose/urea), baseline (Base), and nutrient-enriched (Nutr+, added glucose and urea). \textbf {(B)} The top 12 abundant isolates (by ASV counts) were tested in reciprocal ``mutual invasion'' assays across the three media. Increasing nutrient concentrations lead to a higher frequency of failed species invasions in the pairwise invasion test, indicating nutrient enrichment strengthens competitive interactions. \textbf {(C)} Experimental coalescence maps in similarity space and corresponding PSS histograms for each medium. Marker shapes denote parent pool size (richness class): circles = 6 species, squares = 12 species, triangles = 24 species. \textbf {(D)} The fraction of CLS increases with interaction strength. In nutrient-poor conditions (Nutr$-$), Mixture is the dominant outcome (56\%), with CLS reduced to 34\%. As nutrients increase, CLS progressively dominates, reaching 72\% in Nutr+, consistent with the model prediction.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Predictability of community-level selection separates into two regimes}{13}{subsection.2.5}\protected@file@percent }
\newlabel{sec:results:predictability}{{2.5}{13}{Predictability of community-level selection separates into two regimes}{subsection.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Pairwise competition between dominant species predicts CLS direction only under strong interactions.} \textbf  {(A)} Conceptual framework: CLS could arise from species-driven dynamics (bottom), where the dominant species determines the community-level winner, or from emergent dynamics (top), where multi-species interactions collectively shape the outcome. \textbf  {(B)} Relative abundance of the dominant species in parental communities increases with nutrient concentration, indicating stronger interactions produce more uneven communities. \textbf  {(C)} Relationship between pairwise competition outcome (x-axis: frequency that the focal dominant wins) and coalescence outcome (y-axis: Parental Selection Score, PSS). Predictive power ($R^2$) increases from Nutr$-$ ($R^2 = 0.00$, CLS rare) to Base ($R^2 = 0.11$, emergent CLS) to Nutr+ ($R^2 = 0.49$, species-driven CLS).\relax }}{14}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fig5}{{5}{14}{\textbf {Pairwise competition between dominant species predicts CLS direction only under strong interactions.} \textbf {(A)} Conceptual framework: CLS could arise from species-driven dynamics (bottom), where the dominant species determines the community-level winner, or from emergent dynamics (top), where multi-species interactions collectively shape the outcome. \textbf {(B)} Relative abundance of the dominant species in parental communities increases with nutrient concentration, indicating stronger interactions produce more uneven communities. \textbf {(C)} Relationship between pairwise competition outcome (x-axis: frequency that the focal dominant wins) and coalescence outcome (y-axis: Parental Selection Score, PSS). Predictive power ($R^2$) increases from Nutr$-$ ($R^2 = 0.00$, CLS rare) to Base ($R^2 = 0.11$, emergent CLS) to Nutr+ ($R^2 = 0.49$, species-driven CLS).\relax }{figure.caption.5}{}}
