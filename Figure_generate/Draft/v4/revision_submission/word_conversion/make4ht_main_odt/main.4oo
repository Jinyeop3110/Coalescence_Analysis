yle='italic'></style:text-properties></style:style><style:style style:family='text' style:name='cmmi-6'><style:text-properties fo:font-size='5.4pt' fo:font-style='italic'></style:text-properties></style:style><style:style style:family='text' style:name='cmsy-8'><style:text-properties fo:font-size='7.2pt'></style:text-properties></style:style><style:style style:family='text' style:name='cmsy-6'><style:text-properties fo:font-size='5.4pt'></style:text-properties></style:style><style:style style:family='text' style:name='ecrm-1728'><style:text-properties fo:font-size='15.4pt'></style:text-properties></style:style><style:style style:family='text' style:name='ecrm-1200'><style:text-properties fo:font-size='10.9pt'></style:text-properties></style:style><style:style style:family='text' style:name='ecrm-1000'><style:text-properties fo:font-size='9.0pt'></style:text-properties></style:style><style:style style:family='text' style:name='ecbx-1000'><style:text-properties fo:font-size='9.0pt' fo:font-weight='bold'></style:text-properties></style:style><style:style style:family='text' style:name='ectt-1095'><style:text-properties fo:font-family='monospace,monospace'></style:text-properties></style:style><style:style style:family='text' style:name='ecti-1095'><style:text-properties fo:font-style='italic'></style:text-properties></style:style><style:style style:family='text' style:name='ecbx-1095'><style:text-properties fo:font-weight='bold'></style:text-properties></style:style> <style:style style:family='section' style:name='Figure'> 
