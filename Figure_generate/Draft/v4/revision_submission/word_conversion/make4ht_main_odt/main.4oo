 --><draw:frame draw:name='mobj-180' draw:style-name='mml-inline' draw:z-index='0' text:anchor-type='as-char'><draw:object xlink:actuate='onLoad' xlink:href='./main-m180' xlink:show='embed' xlink:type='simple'></draw:object></draw:frame>
(<!--  l. 107 
 --><draw:frame draw:name='mobj-181' draw:style-name='mml-inline' draw:z-index='0' text:anchor-type='as-char'><draw:object xlink:actuate='onLoad' xlink:href='./main-m181' xlink:show='embed' xlink:type='simple'></draw:object></draw:frame>)
in Base (emergent regime), and <!--  l. 107 
